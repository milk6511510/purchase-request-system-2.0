# Neon PostgreSQL (server-side only)
DATABASE_URL=
# Neon pooled connection string for app runtime; keep it server-side and out of Git.
# Use a separate Neon direct connection only for migrations/admin tasks.

# Google Sheets compatibility mode; used only when DATABASE_URL is unset
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# Server-side login and account bootstrap
AUTH_SECRET=
COMPANY_EMAIL_DOMAIN=
ADMIN_EMPLOYEE_ID=A001
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_FORCE_CHANGE=true

# Email notification, optional
RESEND_API_KEY=
MAIL_FROM=請購單系統 <noreply@example.com>
